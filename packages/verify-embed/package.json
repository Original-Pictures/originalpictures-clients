{
  "name": "@originalpictures/verify",
  "version": "0.1.0",
  "type": "module",
  "description": "Content Credentials (C2PA) verify widget: <op-verify> web component and verify() to check a file's declared origin.",
  "keywords": [
    "c2pa",
    "content-credentials",
    "provenance",
    "verify",
    "verification",
    "web-component",
    "custom-element",
    "ai-watermarking",
    "fingerprinting",
    "eu-ai-act",
    "ai-labeling"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Original Pictures Technologies, Inc.",
    "email": "hello@originalpictures.com",
    "url": "https://originalpictures.com"
  },
  "homepage": "https://docs.originalpictures.com/api/verify-pages/",
  "bugs": {
    "url": "https://github.com/Original-Pictures/originalpictures-clients/issues",
    "email": "hello@originalpictures.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Original-Pictures/originalpictures-clients.git",
    "directory": "packages/verify-embed"
  },
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js",
    "./dist/verify.iife.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./iife": "./dist/verify.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/types/core.d.ts",
        "import": "./dist/core.js"
      },
      "./iife": "./dist/verify.iife.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/build.mjs && vitest run"
  },
  "devDependencies": {
    "@op/eslint-config": "workspace:*",
    "@op/typescript-config": "workspace:*",
    "@types/node": "26.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
